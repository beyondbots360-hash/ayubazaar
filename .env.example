# ===================================
# AyuBazaar Environment Configuration
# ===================================

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://ayubazaar.com

# Razorpay Payment Gateway Keys (From Razorpay Dashboard: Settings > API Keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder

# Brand Admin Email for Receiving Order Notifications (e.g. your Gmail address)
ADMIN_EMAIL=yourname@gmail.com

# SMTP Email Configuration (Using Gmail SMTP with Google App Password)
# If left empty, order alerts will be logged to server console during development.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM="AyuBazaar Orders <yourname@gmail.com>"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://filfttapnwwpxaerappq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin Dashboard Password (for /admin access)
ADMIN_PASSWORD=your_secure_admin_password
